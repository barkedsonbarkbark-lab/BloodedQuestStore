# Firestore data backend
# Option A, easiest on Render: base64 encode your Firebase service account JSON and paste it here.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option B: paste the raw service account JSON as an env var instead.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: isolates this app's collections, e.g. bqs_accounts, bqs_listings, bqs_sessions.
FIRESTORE_PREFIX=bqs

# APK files are still local until Firebase Storage is added.
# On free Render this folder is ephemeral, so uploaded APK files can still be lost on redeploy.
# Use Firebase Storage for real APK persistence.
